# ==============================================================================
# VAULTPAY FINANCIAL CORE - ENVIRONMENT CONFIGURATION
# Nexus Corporate Services LLC | CFO Evelyn Croft
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Authentication & Security
# Cryptographically random string for signing Zero-Trust JSON Web Tokens (24h validity)
JWT_SECRET=nexus_vaultpay_super_secure_jwt_secret_key_2026_cfo_croft

# Stripe Payment Infrastructure
# Live or Test Secret Key from Stripe Dashboard (e.g., sk_test_...)
STRIPE_SECRET_KEY=sk_test_51MockVaultPayKeyForDemo1234567890abcdef

# Stripe Webhook Cryptographic Signing Secret (e.g., whsec_...)
# Used by stripe.webhooks.constructEvent to verify HMAC-SHA256 signatures
STRIPE_WEBHOOK_SECRET=whsec_mockVaultPayWebhookSecretSigner987654321

# Nodemailer / SMTP Email Dispatch Configuration
# In production, provide real SMTP credentials (e.g., Gmail App Password, SendGrid, Amazon SES)
# If omitted, VaultPay automatically operates in high-fidelity mock/jsonTransport mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=billing@nexuscorporateservices.com
SMTP_PASS=your_app_specific_password_here
